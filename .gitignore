# Allowlist: everything in the repo root is ignored by default, and only the paths this project
# explicitly decided to publish are un-ignored below. This is deliberately the safer direction for
# a public repo with a real .env file sitting next to it -- a new file dropped in the root (a
# report, a scratch notebook, an export) is excluded by default instead of silently going public.

/*
!/.gitignore
!/.zenodo.json
!/README.md
!/README_es.md
!/CITATION.cff
!/LICENSE
!/requirements.txt
!/notebooks/
!/src/
!/data/
!/figuras/
!/outputs/

# --- notebooks/: the two top-level notebooks + notebooks/_src/*.py, nothing else ---
/notebooks/*
!/notebooks/*.ipynb
!/notebooks/_src/
/notebooks/_src/*
!/notebooks/_src/*.py
.ipynb_checkpoints/

# --- src/: python scripts only ---
/src/*
!/src/*.py

# --- data/: only data/final, and only the four files this project ships ---
/data/*
!/data/final/
/data/final/*
!/data/final/*.csv
!/data/final/*.parquet
!/data/final/DATA_DICTIONARY.md
!/data/final/mine_workings.csv

# --- figuras/: vector PDFs, source CSVs and LaTeX table fragments -- not the TIFFs (heavy,
# print-only duplicates of the PDFs) or the contact sheet PNG ---
/figuras/*
!/figuras/*.pdf
!/figuras/*.csv
!/figuras/*.tex

# --- figuras/serra/: SERRA submission figures. Unlike the rule above, the TIFF IS the
# deliverable here (journals ask for a 600 dpi raster, not a redundant duplicate of the PDF), and
# EPS is the third required format -- so all three stay, plus the verification CSVs/thumbnails
# (SERRA-R1 T7). The _prev/ backup of a figure about to be replaced is deliberately NOT published:
# it is a local safety copy, not deliverable evidence. ---
!/figuras/serra/
/figuras/serra/*
!/figuras/serra/*.pdf
!/figuras/serra/*.eps
!/figuras/serra/*.tif
!/figuras/serra/*.csv
!/figuras/serra/*.png

# --- outputs/: private by design (internal audit reports) -- EXCEPT outputs/serra_r1/, the
# reproducible-evidence CSV/informe for the pre-submission review (SERRA-R1), which is meant to be
# public. No checkpoints (.nc/.npz) go here regardless. ---
/outputs/*
!/outputs/serra_r1/
/outputs/serra_r1/*
!/outputs/serra_r1/*.csv
!/outputs/serra_r1/*.md
!/outputs/serra_r1/*.txt

# --- outputs/serra_r2/: same rule for the second evidence round (mercury results recomputed with the
# reinforced fit). One small derived-summary .npz (map products, no posterior draws) is shipped on
# purpose; its _prev/ backups stay local. ---
!/outputs/serra_r2/
/outputs/serra_r2/*
!/outputs/serra_r2/*.csv
!/outputs/serra_r2/*.md
!/outputs/serra_r2/*.txt
!/outputs/serra_r2/posterior_maps_Hg_refuerzo.npz

# --- never, anywhere, regardless of the allowlist above ---
.env
*.env
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
Thumbs.db
